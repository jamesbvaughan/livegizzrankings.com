{
  "name": "live-gizz-rankings",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:email": "email dev",
    "dev:tunnel": "lt --port 3000 --subdomain live-gizz-rankings",
